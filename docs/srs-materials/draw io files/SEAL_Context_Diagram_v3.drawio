        <mxCell id="lg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Legend&#xa;&#xa;Solid rounded rectangle: Human external entity&#xa;Dashed rounded rectangle: Optional external system&#xa;Circle: Process 0 &#8211; SEAL System&#xa;Arrow toward the system: Input data&#xa;Arrow away from the system: Output data&#xa;RBL: Research-Based Learning feature&#xa;Optional: Can be removed from MVP scope" vertex="1">
